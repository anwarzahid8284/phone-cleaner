<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topLayout_id"
        android:background="@drawable/button_bg"
        android:layout_marginTop="@dimen/_10sdp"
        android:padding="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:layout_marginStart="@dimen/_3sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="@dimen/_3sdp"
            app:cardElevation="@dimen/_3sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="@dimen/_5sdp"
                android:background="@drawable/buttonbg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/backgroundProcess_id"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_gravity="start"
                    android:gravity="start"
                    android:text="Background Process"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:id="@+id/junkFiles_id"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="Junk Files"
                    android:layout_gravity="end"
                    android:gravity="start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/processSize_id"
                    app:layout_constraintTop_toBottomOf="@id/backgroundProcess_id"
                    app:layout_constraintStart_toStartOf="@id/backgroundProcess_id"
                    android:text="Size: "
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/backProcessSizeID"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintTop_toBottomOf="@id/backgroundProcess_id"
                    app:layout_constraintStart_toEndOf="@id/processSize_id"
                    android:text="5 GB"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/junkTextSize_id"
                    android:text="Size"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintEnd_toStartOf="@id/junkFiles_id"
                    app:layout_constraintTop_toBottomOf="@id/junkFiles_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/junkFileSizeID"
                    app:layout_constraintStart_toEndOf="@id/junkTextSize_id"
                    app:layout_constraintTop_toBottomOf="@id/junkFiles_id"
                    android:text="5.3 GB"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/total_size_layout_id"
        android:padding="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="@id/topLayout_id"
        app:layout_constraintEnd_toEndOf="@id/topLayout_id"
        app:layout_constraintTop_toBottomOf="@id/topLayout_id"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/buttonbg"
        android:layout_width="0dp"
        android:layout_height="wrap_content">
        <TextView
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="Total Size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/totalSizeId"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="5.8 GB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:id="@+id/btnClear_id"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Clear"
        android:background="@drawable/buttonbg"
        app:layout_constraintTop_toBottomOf="@id/total_size_layout_id"
        app:layout_constraintStart_toStartOf="@id/total_size_layout_id"
        app:layout_constraintEnd_toEndOf="@id/total_size_layout_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>